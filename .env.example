# SajiloTools Environment Variables
# Copy this to .env and fill in your values
# For Vercel: set these in Dashboard → Settings → Environment Variables

# Database (local dev: file:./dev.db | production: Turso URL)
DATABASE_URL="file:./dev.db"
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# Canonical Site URL (MUST be production URL on Vercel)
NEXT_PUBLIC_SITE_URL="https://nabint.com.np"

# NextAuth (generate secret: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Gmail SMTP (Contact Form + Newsletter)
# 1. Enable 2-Step Verification on the Gmail account
# 2. Go to myaccount.google.com/apppasswords → create one named "SajiloTools Website"
# 3. Paste the 16-character app password below (with spaces)
GMAIL_USER="sajilotool@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# OAuth Providers (optional)
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET=""

# Admin secret key (MUST be strong in production: openssl rand -base64 32)
ADMIN_SECRET_KEY="generate-a-strong-secret-for-production"

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-3896962422851508"
# NEXT_PUBLIC_ADSENSE_ENABLED="true"
# NEXT_PUBLIC_ADSENSE_FOOTER_SLOT="your-footer-slot-id"
# NEXT_PUBLIC_ADSENSE_ARTICLE_SLOT="your-article-slot-id"